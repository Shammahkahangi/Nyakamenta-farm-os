# Copy to .env and fill in. Never commit .env.

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key

# Used only by scripts/create-web-user.cjs — keep secret, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# After creating users, roles are set in Supabase (Authentication → user → Raw App Meta Data):
#   { "estate_role": "owner" } | "admin" | "manager" | "sacco_lead" | "lodge_lead"
# Or pass the 5th argument to: npm run create-user -- email pass "Name" manager

# Optional: OpenAI for AI Insights (web server proxies this)
# OPENAI_API_KEY=sk-...

# Optional: SQLite directory for npm run web (default: ./data)
# ESTATE_DATA_DIR=

# Offline / flaky network: skip Supabase login in the browser; API accepts Authorization: Bearer local-dev
# (use only on trusted machines — do not enable on a public server)
# ESTATE_LOCAL_WEB_AUTH=1
