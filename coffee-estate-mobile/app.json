{
  "expo": {
    "name": "Nyakamenta Estate OS",
    "slug": "coffee-estate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coffeeestate",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visionatedigital.coffeeestate"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.visionatedigital.coffeeestate",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0f25db44-012b-4a05-a5d3-53c374c55530"
      }
    },
    "owner": "shammahkahangi"
  }
}
